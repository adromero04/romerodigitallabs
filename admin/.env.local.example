# Copy to `.env.local` for local development (never commit real values).
#
# Architecture: this Next.js app runs on a Node-capable host. It holds TWO remote Supabase
# projects (Brewmote and SimpleList) via separate URL + service role pairs. Databases are
# not merged; each client points at its own project.

# --- Admin gate (this dashboard only; not Supabase) ---
# Long random string used to sign the admin session JWT (middleware + cookie).
ADMIN_SESSION_SECRET=replace-with-a-long-random-string-at-least-16-chars
# Single-operator password for /admin/login (use a strong unique password).
ADMIN_PASSWORD=southsider*04

# --- Brewmote Supabase project (remote) ---
BREWMOTE_SUPABASE_URL=https://YOUR_BREWMOTE_PROJECT_REF.supabase.co
BREWMOTE_SUPABASE_SERVICE_ROLE_KEY=your-brewmote-service-role-key

# --- SimpleList Supabase project (remote) ---
SIMPLELIST_SUPABASE_URL=https://YOUR_SIMPLELIST_PROJECT_REF.supabase.co
SIMPLELIST_SUPABASE_SERVICE_ROLE_KEY=your-simplelist-service-role-key
